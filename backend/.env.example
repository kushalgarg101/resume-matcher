# ============================================================================
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# All variables are read by backend/app/core/config.py via pydantic-settings.
# ============================================================================

# --- App ---
# "development" or "production"
ENV=development
API_HOST=0.0.0.0
API_PORT=10000

# --- Supabase (https://supabase.com/dashboard -> Project -> Settings -> API) ---
# Your project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Public "anon" key (Project Settings -> API -> anon public). Used server-side
# to build the USER-SCOPED client whose Authorization header carries the
# caller's JWT so Row Level Security is enforced. Safe to expose to the browser,
# but we keep it on the backend. (The browser uses NEXT_PUBLIC_SUPABASE_ANON_KEY.)
SUPABASE_ANON_KEY=
# "service_role" key — BYPASSES Row Level Security. Keep secret. Used only by
# the worker (and the enqueue-failure rollback) to write analysis results.
SUPABASE_SERVICE_KEY=
# JWT signing secret (Project Settings -> API -> JWT Secret). Used to VERIFY
# incoming user tokens (HS256). If your project uses the newer asymmetric
# "JWT Signing Keys" (ES256/RS256), the backend instead fetches the public keys
# from <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so this can be left blank
# in that case. This is NOT the anon key.
SUPABASE_JWT_SECRET=
# Storage bucket that holds uploaded resumes (created in Supabase Storage UI).
SUPABASE_STORAGE_BUCKET=resumes

# --- Redis (provided automatically by Render as REDIS_URL when you add a
#     Redis service; for local dev point this at your docker-compose redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Groq LLM (https://console.groq.com -> API Keys, free, no credit card) ---
GROQ_API_KEY=
# Choose model by rate-limit / quality tradeoff (see ARCHITECTURE.md):
#   llama-3.1-8b-instant     -> 30 RPM, 14,400 req/day  (default, fast, high quota)
#   llama-3.3-70b-versatile   -> 30 RPM, 1,000 req/day   (stronger reasoning)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_REQUEST_TIMEOUT=30
GROQ_MAX_RETRIES=4

# --- Limits ---
# Max resume upload size in bytes (default 5 MB).
MAX_PDF_BYTES=5242880

# If true, the worker deletes each resume PDF from Storage after processing
# (success or final failure) to bound free-tier storage growth. Leave false to
# keep resumes for debugging / re-processing.
DELETE_RESUME_AFTER_PROCESSING=false

# Shared secret for internal admin endpoints (e.g. POST /internal/reap, called
# by the keepalive cron to mark stuck queued/processing rows as failed). Any
# long random string. Leave blank only for local dev (disables the check).
INTERNAL_API_KEY=

# --- CORS (comma separated). Include your Vercel frontend URL in production. ---
CORS_ALLOW_ORIGINS=http://localhost:3000
